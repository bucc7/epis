# epis example configuration, copy to ~/.config/epis/config

[general]
maildir = ~/Mail
leader = <Space>
# vim keys in the message editor
vim_edit = yes
# yanked text goes to the system clipboard, and p pastes from it
clipboard = yes
# the menu inside the window; macOS always uses the system menu bar
menubar = yes
font_size = 15
# font = /usr/share/fonts/noto/NotoSans-Regular.ttf
# font_mono = /usr/share/fonts/noto/NotoSansMono-Regular.ttf
# on macOS, for example: font_mono = /System/Library/Fonts/SFNSMono.ttf
# extra UI zoom on top of the output scale
# scale = 1.25

[account work]
email = me@example.com
name = My Name
imap_host = imap.example.com
imap_port = 993
imap_security = tls
smtp_host = smtp.example.com
smtp_port = 465
smtp_security = tls
user = me@example.com
# auto, plain, login, cram-md5, scram-sha-1, scram-sha-256, xoauth2,
# oauthbearer or none
auth = auto
password_cmd = pass show mail/work
sent = Sent
drafts = Drafts
trash = Trash
archive = Archive
signature = My Name

[account gmail]
email = me@gmail.com
imap_host = imap.gmail.com
smtp_host = smtp.gmail.com
auth = xoauth2
oauth = google
oauth_client_id = YOUR-CLIENT-ID.apps.googleusercontent.com
oauth_client_secret = YOUR-CLIENT-SECRET
sent = [Gmail].Sent Mail
trash = [Gmail].Trash
save_sent = no

[theme]
# include = ~/.config/epis/themes/light.theme
accent = #89b4fa
# colour of the mode name in the status bar; normal follows accent if unset
mode_insert = #a6e3a1
mode_visual = #cba6f7
# also: mode_normal, mode_vline, mode_command, mode_find, mode_setup
radius = 6

[keys]
# CONTEXT KEYS = COMMAND, contexts: global list message mail compose
list <leader>i = folder INBOX
mail A = archive
global <C-s> = sync

[commands]
# custom commands, usable with : and in [keys]
spam = move Junk
inbox = folder INBOX
notify = !notify-send "epis" "sync done"
# feedkeys replays keys, ; separates commands
toptwo = top; feedkeys jj

[llm]
# uses the Claude API, the key may also come from ANTHROPIC_API_KEY
api_key_cmd = pass show api/anthropic
model = claude-opus-5-5
